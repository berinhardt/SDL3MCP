@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The exported interface names exactly these two targets. nlohmann/json and stb
# are private to the library build, so a consumer needs neither of them.
find_dependency(SDL3 CONFIG)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/SDL3MCPTargets.cmake")

check_required_components(SDL3MCP)
