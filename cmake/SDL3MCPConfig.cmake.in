@PACKAGE_INIT@

# The exported interface names one target, SDL3MCP::SDL3MCP. The Handler
# executable and the COMMON composition target are build-tree artifacts, and
# nlohmann/json and stb are private to the library build, so a consumer needs
# neither of them.
#
# SDL3MCP publishes no SDL: the consumer finds SDL itself and names the SDL
# target it links on its own link line, so there is no find_dependency(SDL3)
# here.

include("${CMAKE_CURRENT_LIST_DIR}/SDL3MCPTargets.cmake")

check_required_components(SDL3MCP)
